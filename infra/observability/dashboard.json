{
  "__inputs": [
    {
      "name": "DS_PROMETHEUS",
      "label": "Prometheus",
      "type": "datasource",
      "pluginId": "prometheus",
      "pluginName": "Prometheus"
    }
  ],
  "uid": "tholi-operations",
  "title": "Tholi service operations",
  "schemaVersion": 39,
  "version": 1,
  "tags": ["tholi", "operations"],
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP error rate",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(tholi_operation_count_total{tholi_operation=\"http.request\",tholi_outcome=\"error\"}[5m])) / clamp_min(sum(rate(tholi_operation_count_total{tholi_operation=\"http.request\"}[5m])), 0.01)",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP and provider p95 latency",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, tholi_operation) (rate(tholi_operation_duration_ms_bucket{tholi_operation=~\"http.request|identity.exchange|smtp.send|storage.*\"}[5m])))",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Database pool capacity",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service_name, __name__) ({__name__=~\"tholi_database_pool_(total|idle|waiting)\"})",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Database connection p95 wait",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, service_name) (rate(tholi_database_pool_wait_ms_bucket[5m])))",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Worker healthy",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min(tholi_worker_healthy)",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Worker active attempts",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(tholi_worker_active)",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Due job age",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tholi_jobKind) (tholi_job_queue_age_ms{tholi_jobStatus=\"queued\"})",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Queue states",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (tholi_jobKind, tholi_jobStatus) (tholi_job_queue_count)",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Retries and rejected stale fences",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) (rate({__name__=~\"tholi_job_(retries|stale_fences)_total\"}[5m]))",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Telemetry losses",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (__name__) (increase({__name__=~\"tholi_telemetry_(dropped|export_failures)_total\"}[5m]))",
          "legendFormat": "{{service_name}} {{tholi_operation}} {{tholi_jobKind}} {{tholi_jobStatus}}",
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        }
      }
    },
    {
      "id": 11,
      "type": "text",
      "title": "Unavailable producers",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Recorded provider cost and retained liability come from the authoritative PostgreSQL accounting owner. Live provider billing, cost per independently verified success, interactive model stale results and Local/Free/Paid activation remain unmeasured or unavailable. Missing data is not zero. A proposal does not establish arrival; sign-in does not establish paid activation. Alerts require an operator-owned Prometheus and routing configuration."
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "Provider failure rate",
      "gridPos": {
        "x": 0,
        "y": 44,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (tholi_provider) (rate(tholi_operation_count_total{tholi_provider=~\"oidc|smtp|s3\",tholi_outcome=~\"error|not-sent|uncertain|unavailable|timeout\"}[5m])) / clamp_min(sum by (tholi_provider) (rate(tholi_operation_count_total{tholi_provider=~\"oidc|smtp|s3\"}[5m])), 0.01)",
          "legendFormat": "{{tholi_provider}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Recorded provider cost and retained liability",
      "description": "Global SQL aggregates are replicated by workers. Maximum avoids double-counting them; unavailable accounting health excludes stale series. This is not a provider invoice or cost per verified success.",
      "gridPos": { "x": 0, "y": 52, "w": 24, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "targets": [
        {
          "refId": "A",
          "expr": "max(tholi_inference_settled_usd_micros and (tholi_inference_health_available == 1)) / 1000000",
          "legendFormat": "Recorded USD"
        },
        {
          "refId": "B",
          "expr": "max(tholi_inference_reserved_usd_micros and (tholi_inference_health_available == 1)) / 1000000",
          "legendFormat": "Retained maximum USD"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "currencyUSD" }, "overrides": [] }
    }
  ]
}
