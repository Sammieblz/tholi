{
  "manifest_version": 3,
  "name": "Internet Navigator",
  "version": "0.9.1",
  "description": "Live page discovery, goal-based guidance, and private local site memory. You make every click.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "webNavigation",
    "offscreen"
  ],
  "action": {
    "default_title": "Open Internet Navigator"
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://en.wikipedia.org/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"]
}
