{
  "manifest_version": 3,
  "name": "Tholi",
  "version": "0.10.1",
  "description": "Your next step, made clear. Local website guidance while you stay in control.",
  "permissions": [
    "activeTab",
    "tabs",
    "scripting",
    "sidePanel",
    "storage",
    "webNavigation",
    "offscreen"
  ],
  "action": {
    "default_title": "Open Tholi",
    "default_icon": {
      "16": "media/icon-16.png",
      "32": "media/icon-32.png"
    }
  },
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://en.wikipedia.org/*"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "icons": {
    "16": "media/icon-16.png",
    "32": "media/icon-32.png",
    "48": "media/icon-48.png",
    "128": "media/icon-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "widget.html",
        "sidepanel.js",
        "sidepanel.css",
        "*.woff2",
        "media/*.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
