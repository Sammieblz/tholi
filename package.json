{
  "name": "internet-navigator",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev:demo": "vite --config apps/demo-saas/vite.config.ts",
    "build": "npm run build:demo && npm run build:extension",
    "build:demo": "vite build --config apps/demo-saas/vite.config.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages routes tests scripts docs *.ts *.json README.md",
    "test:live:wikipedia": "playwright test --config playwright.live.config.ts",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "package:extension": "node scripts/package-extension.mjs",
    "fetch:model": "node scripts/fetch-model.mjs",
    "build:api": "node scripts/build-api.mjs",
    "start:api": "node apps/api/dist/cli.js",
    "test:nlp": "vitest run --config vitest.nlp.config.ts",
    "package:api": "node scripts/package-api.mjs",
    "test:nlp:browser": "playwright test --config playwright.nlp.config.ts",
    "test:multi-app": "vitest run --config vitest.multi-app.config.ts",
    "test:multi-app:browser": "playwright test --config playwright.multi-app.config.ts",
    "pretest:nlp": "npm run build:api",
    "pretest:multi-app": "npm run build:api"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "packages/navigation-core",
    "packages/nlp",
    "apps/api"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "license": "MIT"
}
