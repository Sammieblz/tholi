{
  "name": "tholi",
  "description": "Local website guidance that keeps your destination in view while you stay in control.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sammieblz/tholi.git"
  },
  "author": "ILUNỌNSEN LLC",
  "private": true,
  "version": "0.11.0",
  "type": "module",
  "scripts": {
    "dev:demo": "vite --config apps/demo-saas/vite.config.ts",
    "build": "npm run check:version && npm run build:demo && npm run build:extension && npm run build:web && npm run build:api && npm run build:test-fixtures",
    "build:demo": "vite build --config apps/demo-saas/vite.config.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "build:extension:experimental:paddle": "node scripts/build-extension.mjs --with-paddle",
    "check:version": "node scripts/version.mjs --check",
    "release:version": "node scripts/version.mjs",
    "check:website": "node scripts/website-version.mjs --check",
    "release:website": "node scripts/website-version.mjs",
    "package:website": "node scripts/package-website.mjs",
    "typecheck": "npm run check:version && tsc --noEmit",
    "test": "node scripts/test.mjs unit",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "node scripts/test.mjs core",
    "format": "prettier --write apps packages routes tests scripts docs config .github *.ts *.json *.md",
    "test:live:wikipedia": "node scripts/test.mjs live",
    "test:navigation:baseline": "node scripts/test.mjs navigation-baseline",
    "test:acceptance": "node scripts/test.mjs acceptance",
    "package:extension": "node scripts/package-extension.mjs",
    "fetch:ocr": "node scripts/fetch-ocr.mjs",
    "test:vision": "node scripts/test.mjs vision",
    "test:reliability:browser": "node scripts/test.mjs reliability",
    "fetch:paddle": "node scripts/fetch-paddle.mjs",
    "test:continuity:browser": "node scripts/test.mjs continuity",
    "fetch:model": "node scripts/fetch-model.mjs",
    "build:api": "node scripts/build-api.mjs",
    "start:api": "node apps/api/dist/cli.js",
    "start:service": "node apps/api/dist/service.js",
    "local:init": "node scripts/local-stack.mjs init",
    "local:up": "node scripts/local-stack.mjs up",
    "local:down": "node scripts/local-stack.mjs down",
    "local:migrate": "node scripts/local-stack.mjs migrate",
    "local:seed": "node scripts/local-stack.mjs seed",
    "local:reset": "node scripts/local-stack.mjs reset",
    "test:local-stack": "node scripts/local-stack-smoke.mjs",
    "test:nlp": "node scripts/test.mjs nlp",
    "package:api": "node scripts/package-api.mjs",
    "test:nlp:browser": "node scripts/test.mjs nlp-browser",
    "test:multi-app": "node scripts/test.mjs multi-app",
    "test:multi-app:browser": "node scripts/test.mjs multi-app-browser",
    "dev:web": "node scripts/sync-downloads.mjs && vite --config apps/web/vite.config.ts",
    "build:web": "npm run check:website && node scripts/sync-downloads.mjs && vite build --config apps/web/vite.config.ts",
    "test:ui": "node scripts/test.mjs ui",
    "capture:web": "node scripts/capture-product-screenshots.mjs",
    "capture:video": "node scripts/capture-product-video.mjs",
    "test:ci": "node scripts/test.mjs ci",
    "test:full": "node scripts/test.mjs full",
    "build:test-fixtures": "node scripts/build-test-fixtures.mjs",
    "fetch:browser-tools": "node scripts/fetch-browser-tools.mjs",
    "test:browsers": "node scripts/test.mjs brands"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/newsreader": "5.3.0",
    "@fontsource-variable/outfit": "5.3.0",
    "@fontsource-variable/source-sans-3": "5.3.1",
    "gsap": "3.15.0",
    "iconoir-react": "7.12.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "webextension-polyfill": "0.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^24.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/selenium-webdriver": "4.35.7",
    "@types/webextension-polyfill": "0.12.6",
    "esbuild": "^0.25.0",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "selenium-webdriver": "4.51.0",
    "sharp": "0.35.5",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.3"
  },
  "workspaces": [
    "packages/navigation-core",
    "packages/nlp",
    "packages/vision",
    "apps/api",
    "packages/ui"
  ],
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "license": "MIT"
}
