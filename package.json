{
  "name": "internet-navigator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev:demo": "vite --config apps/demo-saas/vite.config.ts",
    "build": "npm run build:demo && npm run build:extension",
    "build:demo": "vite build --config apps/demo-saas/vite.config.ts",
    "build:extension": "node scripts/build-extension.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm test && npm run build",
    "test:e2e": "playwright test",
    "format": "prettier --write apps packages routes tests scripts docs *.ts *.json README.md",
    "test:live:wikipedia": "playwright test --config playwright.live.config.ts",
    "test:acceptance": "playwright test --config playwright.acceptance.config.ts",
    "package:extension": "node scripts/package-extension.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/chrome": "^0.0.300",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.9",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.0"
  }
}
