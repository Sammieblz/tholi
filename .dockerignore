# Keep the build context limited to the existing API build and workspace owners.
**
!package.json
!package-lock.json
!LICENSE
!apps/
!apps/api/
!apps/api/Dockerfile
!apps/api/package.json
!apps/api/src/
!apps/api/src/**
!packages/
!packages/**
!scripts/
!scripts/build-api.mjs
!tests/
!tests/integration/
!tests/integration/postgres/
!tests/integration/postgres/**
!tests/support/
!tests/support/saved-data-fixture.ts
!tests/support/navigation-model-fixture.ts

# Never copy local dependencies, generated output or secrets from allowed trees.
**/node_modules
**/dist
# Explicit prepared-image mode permits only the API artifact tree. Secret
# exclusions below still win; its Docker COPY selects JS and source maps only.
!apps/api/dist/
!apps/api/dist/*.js
!apps/api/dist/*.js.map
**/.env*
**/*.env
**/.npmrc
**/.netrc
**/*.pem
**/*.key
**/.git
**/.codex
**/.agents
**/.aws
**/.navigator-api
**/output
