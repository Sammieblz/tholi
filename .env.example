# Synthetic local development values only. Run local initialization to replace
# passwords and storage credentials. Never reuse this file for deployment.
COMPOSE_PROJECT_NAME=tholi-local
API_HOST_PORT=8788
OIDC_HOST_PORT=18080
MAIL_HOST_PORT=18025
STORAGE_HOST_PORT=18333
THOLI_WEB_ORIGIN=http://127.0.0.1:5174
# Optional redacted telemetry stays on the private application network.
# Enable this together with --profile telemetry; it never enables product analytics.
THOLI_OBSERVABILITY_ENABLED=false
# Optional authenticated navigation transport uses only the deterministic fake.
THOLI_NAVIGATION_TRANSPORT_ENABLED=false
POSTGRES_ADMIN_PASSWORD=local-only-postgres-password
THOLI_DB_PASSWORD=local-only-runtime-password
THOLI_WORKER_PASSWORD=local-only-worker-password
THOLI_MIGRATION_PASSWORD=local-only-migration-password
OIDC_DB_PASSWORD=local-only-identity-password
OIDC_ADMIN_PASSWORD=local-only-admin-password
OIDC_TEST_PASSWORD=local-only-test-password
THOLI_IDENTITY_CLIENT_SECRET_KEY=local-only-client-secret-replaced-by-local-init
THOLI_IDENTITY_FLOW_SECRET_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
# Explicit provider-hosted account controls for this synthetic local realm only.
THOLI_IDENTITY_ACCOUNT_MANAGEMENT_URL=http://localhost:${OIDC_HOST_PORT}/realms/tholi-local/account/
THOLI_FILE_LINK_SECRET_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBA
THOLI_IDENTITY_CHROMIUM_CALLBACKS=https://pliafmeneaalhbecphnodbifdfcajngk.chromiumapp.org/
THOLI_IDENTITY_FIREFOX_CALLBACKS=https://d4bd973634224dbedf2eaafa4d28431134526881.extensions.allizom.org/
STORAGE_ACCESS_KEY=tholi-local-example
STORAGE_SECRET_KEY=local-only-storage-secret

# The default stack has no model-provider credentials or external mail delivery.
# Live HTTP inference still requires production quota and credit admission.
# Operator experiments are separate and require reviewed data and spending approval.
